{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "release:stamp": "node scripts/write-release-stamp.mjs",
    "livebuild": "npm run release:stamp && php vendor/bin/vapor deploy production && npm run deploy:ssr",
    "both": "npm run release:stamp && php vendor/bin/vapor deploy development && php vendor/bin/vapor deploy production",
    "devbuild": "npm run release:stamp && php vendor/bin/vapor deploy development && node -e \"console.log('\\n⚠️  SSR bundle NOT pushed. One host serves both environments, so a push from a dev release changes PRODUCTION too. Run npm run deploy:ssr only once production carries the matching PHP.\\n')\"",
    "build": "npm run check && vite build",
    "ssr:dev": "vite build --ssr resources/js/ssr-marketing.jsx --outDir bootstrap/ssr --watch & node bootstrap/ssr/ssr.js",
    "ssr:build": "vite build --ssr resources/js/ssr-marketing.jsx --outDir bootstrap/ssr",
    "build:fast": "vite build --mode=production --minify --no-sourcemap",
    "clear": "php artisan cache:clear && php artisan optimize:clear && php artisan config:clear && php artisan route:clear",
    "build:critical": "./scripts/build-with-critical-css.sh && npm run sw:build",
    "build:production": "npm run build && npm run sw:build",
    "push": "git add . && git commit -m 'merge changes' && git push",
    "sw:build": "node scripts/build-sw.js",
    "sw:dev": "workbox generateSW workbox-config.js",
    "critical:generate": "php artisan css:critical",
    "critical:penthouse": "node scripts/generate-critical-css.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:snapshots": "jest --updateSnapshot",
    "test:unit": "php artisan test tests/Unit/",
    "test:feature": "php artisan test tests/Feature/",
    "test:integration": "php artisan test tests/Integration/",
    "fonts:optimize": "node scripts/optimize-fonts.js",
    "fonts:optimize:prod": "node scripts/optimize-fonts.js https://spennypiggy.co",
    "fonts:subset": "node scripts/subset-fonts-basic.js",
    "lhci:collect": "lhci collect",
    "lhci:upload": "lhci upload",
    "lhci:autorun": "lhci autorun",
    "lhci:healthcheck": "lhci healthcheck",
    "performance:test": "npx playwright test --project=performance-fast",
    "performance:mobile": "npx playwright test --project=mobile-chrome",
    "performance:desktop": "npx playwright test --project=chromium-desktop",
    "performance:all": "npx playwright test tests/performance/",
    "performance:report": "npx playwright show-report",
    "ci:test": "npm run test:unit && npm run test:feature && npm run performance:test",
    "ci:lighthouse": "npm run lhci:autorun",
    "ci:full": "npm run ci:test && npm run ci:lighthouse",
    "deploy:staging": "npm run devbuild",
    "deploy:production": "npm run livebuild",
    "health:check": "curl -f http://localhost:8000/health || curl -f https://spennypiggy.co/health",
    "monitoring:setup": "php artisan migrate:fresh --seed && php artisan web-vitals:setup",
    "liveboth": "npm run livebuild && cd .. && cd admin.spennypiggy.co/ && npm run livebuild",
    "devboth": "npm run devbuild && cd .. && cd admin.spennypiggy.co/ && npm run devbuild",
    "check": "node scripts/checks/run.mjs .",
    "pwa:splash": "node scripts/build-pwa-splash.mjs",
    "deploy:ssr": "./scripts/deploy-ssr.sh --yes"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.27.1",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.12",
    "babel-jest": "^30.4.1",
    "babel-plugin-react-html-attrs": "^3.0.5",
    "commander": "^14.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "laravel-vite-plugin": "^1.2.0",
    "postcss": "^8.4.18",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^3.2.1",
    "terser": "^5.43.1",
    "vite": "^6.2.4",
    "webpack-bundle-analyzer": "^4.10.2",
    "workbox-build": "^7.3.0",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "dependencies": {
    "@animateicons/react": "^0.4.3",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@github/webauthn-json": "^2.1.1",
    "@headlessui/react": "^1.4.2",
    "@heroicons/react": "^2.2.0",
    "@inertiajs/react": "^1.0.0",
    "@inertiajs/server": "^0.1.0",
    "@magicbell/magicbell-react": "^11.3.2",
    "@magicbell/webpush": "^2.1.0",
    "@midudev/tailwind-animations": "^0.2.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@rye-api/rye-sdk": "^1.4.2",
    "@sentry/react": "^10.53.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@stripe/stripe-js": "^5.4.0",
    "@tailwindcss/forms": "^0.5.3",
    "@uploadcare/blocks": "0.50.4",
    "aos": "^2.3.4",
    "axios": "^1.1.2",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "date-fns": "^4.2.1",
    "force": "^0.0.3",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "lenis": "^1.3.23",
    "lucide-react": "^0.544.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-lazy-load-image-component": "^1.6.0",
    "react-redux": "^8.1.3",
    "react-scrollspy": "^3.4.3",
    "react-select": "^5.8.0",
    "recharts": "^2.15.4",
    "redux": "^4.2.1",
    "scriptjs": "^2.5.9",
    "swiper": "^11.0.3",
    "web-vitals": "^3.5.2",
    "workbox-window": "^7.3.0",
    "ziggy-js": "^2.6.0"
  }
}
