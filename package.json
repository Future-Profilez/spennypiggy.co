{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "livebuild": "php vendor/bin/vapor deploy production --message='implementing stripe identity verification' --commit='619ad66b'",
        "devbuild": "php vendor/bin/vapor deploy development --message='implementing stripe identity verification' --commit='619ad66b'",
        "build": "vite build && npm run sw:build",
        "build:fast": "vite build --mode=production --minify --no-sourcemap",
        "clear": "php artisan cache:clear && php artisan optimize:clear && php artisan config:clear && php artisan route:clear",
        "build:critical": "./scripts/build-with-critical-css.sh && npm run sw:build",
        "build:production": "npm run build && npm run sw:build",
        "sw:build": "node scripts/build-sw.js",
        "sw:dev": "workbox generateSW workbox-config.js",
        "critical:generate": "php artisan css:critical",
        "critical:penthouse": "node scripts/generate-critical-css.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:snapshots": "jest --updateSnapshot",
        "test:unit": "php artisan test tests/Unit/",
        "test:feature": "php artisan test tests/Feature/",
        "test:integration": "php artisan test tests/Integration/",
        "fonts:optimize": "node scripts/optimize-fonts.js",
        "fonts:optimize:prod": "node scripts/optimize-fonts.js https://spennypiggy.co",
        "fonts:subset": "node scripts/subset-fonts-basic.js",
        "lhci:collect": "lhci collect",
        "lhci:upload": "lhci upload",
        "lhci:autorun": "lhci autorun",
        "lhci:healthcheck": "lhci healthcheck",
        "performance:test": "npx playwright test --project=performance-fast",
        "performance:mobile": "npx playwright test --project=mobile-chrome",
        "performance:desktop": "npx playwright test --project=chromium-desktop",
        "performance:all": "npx playwright test tests/performance/",
        "performance:report": "npx playwright show-report",
        "ci:test": "npm run test:unit && npm run test:feature && npm run performance:test",
        "ci:lighthouse": "npm run lhci:autorun",
        "ci:full": "npm run ci:test && npm run ci:lighthouse",
        "deploy:staging": "php vendor/bin/vapor deploy development",
        "deploy:production": "php vendor/bin/vapor deploy production",
        "health:check": "curl -f http://localhost:8000/health || curl -f https://spennypiggy.co/health",
        "monitoring:setup": "php artisan migrate:fresh --seed && php artisan web-vitals:setup"
    },
    "devDependencies": {
        "@babel/plugin-transform-react-jsx": "^7.27.1",
        "@babel/preset-react": "^7.27.1",
        "@lhci/cli": "^0.12.0",
        "@rollup/rollup-darwin-arm64": "^4.0.0",
        "@vitejs/plugin-react": "^4.0.3",
        "autoprefixer": "^10.4.12",
        "babel-plugin-react-html-attrs": "^3.0.5",
        "commander": "^14.0.0",
        "critters": "^0.0.25",
        "esbuild": "^0.25.2",
        "glyphhanger": "^5.0.0",
        "laravel-vite-plugin": "^1.2.0",
        "penthouse": "^2.3.3",
        "postcss": "^8.4.18",
        "rollup-plugin-visualizer": "^6.0.3",
        "tailwindcss": "^3.2.1",
        "terser": "^5.43.1",
        "vite": "^6.2.4",
        "webpack-bundle-analyzer": "^4.10.2",
        "workbox-build": "^7.3.0",
        "workbox-webpack-plugin": "^7.3.0"
    },
    "dependencies": {
        "@apollo/client": "^3.13.1",
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^8.0.0",
        "@hcaptcha/react-hcaptcha": "^1.9.2",
        "@headlessui/react": "^1.4.2",
        "@inertiajs/react": "^1.0.0",
        "@magicbell/magicbell-react": "^11.3.2",
        "@magicbell/webpush": "^2.1.0",
        "@midudev/tailwind-animations": "^0.2.0",
        "@reduxjs/toolkit": "^1.9.7",
        "@rollup/rollup-win32-x64-msvc": "^4.52.5",
        "@rye-api/rye-sdk": "^1.4.2",
        "@sentry/react": "^9.39.0",
        "@sentry/replay": "^7.116.0",
        "@sentry/tracing": "^7.120.3",
        "@sentry/vite-plugin": "^3.5.0",
        "@stripe/stripe-js": "^5.4.0",
        "@tailwindcss/forms": "^0.5.3",
        "@uploadcare/blocks": "0.25.0",
        "aos": "^2.3.4",
        "axios": "^1.1.2",
        "bootstrap": "^5.3.2",
        "canvas-confetti": "^1.9.2",
        "chart.js": "^4.4.0",
        "cross-spawn": "^7.0.6",
        "graphql": "^16.10.0",
        "html2canvas": "^1.4.1",
        "install": "^0.13.0",
        "lucide-react": "^0.544.0",
        "npm": "^10.5.0",
        "react": "^18.3.1",
        "react-bootstrap": "^2.9.1",
        "react-dom": "^18.3.1",
        "react-feather": "^2.0.10",
        "react-helmet": "^6.1.0",
        "react-hot-toast": "^2.4.1",
        "react-icons": "^5.2.1",
        "react-lazy-load-image-component": "^1.6.0",
        "react-redux": "^8.1.3",
        "react-router-dom": "^6.18.0",
        "react-scrollspy": "^3.4.3",
        "react-select": "^5.8.0",
        "react-tabs-scrollable": "^2.0.6",
        "recharts": "^2.12.0",
        "redux": "^4.2.1",
        "scriptjs": "^2.5.9",
        "sitemap-generator": "^7.5.2",
        "styled-components": "^6.1.1",
        "swiper": "^11.0.3",
        "uninstall": "^0.0.0",
        "web-vitals": "^3.5.2",
        "workbox-window": "^7.3.0"
    }
}
