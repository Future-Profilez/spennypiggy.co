APP_ENV=testing
# Throwaway key for the test suite only. The previous placeholder
# (base64:xxxx...) decoded to the wrong length, so Laravel's encrypter
# refused it and every test that boots the HTTP kernel failed.
APP_KEY=base64:x0KHfTF9YDgSEkT+jyQVrD+DwHiHOfEV0MKMdvoz2Gk=
DB_CONNECTION=mysql
DB_DATABASE=spennypiggy_testing
DB_USERNAME=root
DB_PASSWORD=
QUEUE_CONNECTION=sync

# Fake Stripe credentials — tests must never reach the real Stripe API.
# They exist because Laravel loads THIS file instead of .env when APP_ENV=testing,
# so without them config('services.stripe.*') is null and StripeControl throws
# "Stripe UK API key is not properly configured" in any test that touches it.
STRIPE_PUBLIC_KEY=pk_test_fake_key_for_tests
STRIPE_SECRET_KEY=sk_test_fake_key_for_tests
STRIPE_SECRET_KEY_US=sk_test_fake_key_for_tests_us
STRIPE_WEBHOOK_SECRET=whsec_fake_secret_for_tests
STRIPE_WEBHOOK_SECRET_US=whsec_fake_secret_for_tests_us

# Bank payments are enabled in .env, but .env is not read during tests, and the
# config default is false — so PayByBankInstantFulfilmentTest saw false and failed.
# Set here to match the development environment the tests were written against.
BANK_PAYMENTS_ENABLED=true
