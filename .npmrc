# Speed up npm installs for Vapor builds
audit=false
fund=false
prefer-online=true
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Disable progress for CI/build environments  
progress=false
loglevel=error

# Use npm cache efficiently
cache-max=86400000

# Disable optional dependencies and dev dependencies in production
optional=false