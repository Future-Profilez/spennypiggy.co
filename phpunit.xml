<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The `sentry` log channel is in the default stack, so without this an
             expected-failure test would file a real issue in the production Sentry
             project. An empty DSN makes the channel a no-op. -->
        <!--
            🚨 SSR IS OFF IN TESTS, AND THE URL IS WHAT TURNS IT OFF.
            `EnableSsr::willRender()` answers false with no render host, which
            keeps `StaticPageSeoMiddleware` in charge of the social tags on the
            /creators routes. Without this the answer depends on whether the
            machine running the suite happens to have `bootstrap/ssr/ssr.js`
            built — present locally, absent in CI — so AdPageSocialCardTest
            would pass or fail on a build artefact rather than on this code.
            It also stops any test making a real HTTP call to a render host.
            Same reasoning as the blanked Sentry DSN above.
        -->
        <env name="SSR_URL" value=""/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="SENTRY_DSN" value=""/>
        <!--
            Analytics is OFF outside production (config/analytics.php), so the
            test suite has to turn it ON or every analytics test would pass by
            doing nothing — the exact failure the `runningInConsole` guard was
            removed to avoid. Tests of the OFF behaviour set the config
            themselves.
        -->
        <env name="ANALYTICS_ENABLED" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="IDENTITY_RETENTION_DELETE_CDN" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
