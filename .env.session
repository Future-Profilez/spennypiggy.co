# Session Configuration for Website (spennypiggy.co)
# Add these to your .env file to fix CSRF token conflicts

# Unique session cookie name for the website
SESSION_COOKIE=spenny_web_session

# Keep SESSION_DOMAIN empty for host-only cookies (prevents conflicts with admin)
SESSION_DOMAIN=

# For production, ensure secure cookies over HTTPS
SESSION_SECURE_COOKIE=true

# Other session settings (keep existing values if already configured)
SESSION_DRIVER=file
SESSION_LIFETIME=120