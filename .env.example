
# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID).
# The button only renders when BOTH are set. Redirect URI is APP_URL + /auth/google/callback
# and must be registered in the console exactly, per environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Creator attribution watermark — stamps the creator's profile URL onto public
# preview images. OFF by default: each overlay creates a new derived Uploadcare
# asset per variant, so turn it on after a bandwidth/cost check.
# Enable order: run the migration, pre-warm with "watermarks:generate --force --sync",
# THEN switch this on. The column is only selected while it is on, so enabling
# before migrating errors.
# The dimensions MUST be two-dimensional (`34px34p`); a bare `34p` makes the CDN
# reject the coordinates that follow it and 400 the whole image.
MEDIA_WATERMARK_ENABLED=false
MEDIA_WATERMARK_DIMENSIONS=34px34p
MEDIA_WATERMARK_COORDINATES=4p,90p
MEDIA_WATERMARK_OPACITY=45p
MEDIA_WATERMARK_HOST=spennypiggy.co

# Secure delivery for PAID content (signed, expiring CDN URLs).
# 🚨 Leave MEDIA_SECURE_ENABLED=false until BOTH are true in the Uploadcare
# dashboard: Project -> Delivery -> "Secure delivery" is ON, and the hex CDN
# secret it issues is pasted into UPLOADCARE_SECURE_KEY below.
# ⚠️ UPLOADCARE_SECURE_KEY is a different value from UPLOADCARE_SECRET_KEY (the
# API key). SecureMedia falls back to the API key if this is blank, but if the
# project's CDN secret differs that fallback 403s every paid download.
# Verify with: php artisan media:secure-check
MEDIA_SECURE_ENABLED=false
MEDIA_SECURE_TTL=3600
MEDIA_SECURE_DELIVERY_TTL=2592000
UPLOADCARE_SECURE_KEY=

# Help Centre AI answers (config/help.php).
# Both a key and the flag are required, or the Ask AI button stays hidden.
#
# Default provider is OpenAI. ONE OpenAI key covers images, chat and
# embeddings — there is no separate "DALL-E key"; DALLE_SECRET_KEY is the
# legacy name and still works.
OPENAI_API_KEY=
HELP_AI_ENABLED=false
#
# Any OpenAI-compatible host works instead. Set ALL FOUR together — the OpenAI
# keys above are deliberately NOT used against another host — then run
# `php artisan config:clear && php artisan help:embed && php artisan cache:clear`.
# Verify the model names in the provider's console; they change.
# Read the provider's data policy first: supporters' own questions go there.
#
# Several keys, comma-separated — the pool rotates across them and stands one
# down when its provider says 429, for as long as the provider says.
# ⚠️ A free quota is per ACCOUNT: two keys from ONE account share ONE quota.
# Each key here should come from its own account. `php artisan help:ai-status`
# shows which keys are healthy and how often each was stood down today.
# HELP_AI_API_KEYS=gsk_first...,gsk_second...,gsk_third...
#
# Groq (free tier):
# HELP_AI_BASE_URL=https://api.groq.com/openai/v1
# HELP_AI_API_KEY=                 # or HELP_AI_API_KEYS above
# HELP_AI_ANSWER_MODEL=llama-3.3-70b-versatile
# HELP_AI_EMBEDDING_MODEL=nomic-embed-text-v1_5
#
# Gemini (free tier):
# HELP_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HELP_AI_API_KEY=
# HELP_AI_ANSWER_MODEL=gemini-2.0-flash-lite
# HELP_AI_EMBEDDING_MODEL=gemini-embedding-001

# Identity / KYC retention (app/Console/Commands/PruneIdentityData.php).
# 🚨 REPORT-ONLY until IDENTITY_RETENTION_ENABLED=true. This schema carries no
# legal-hold marker of any kind, so a human flipping this flag stands in for the
# marker the database does not have. Open disputes, open early fraud warnings,
# unsettled payouts, held reserves and suspended accounts are excluded in code.
# 1825 days is the UK MLR 2017 statutory maximum and is deliberately inert out of
# the box — run `php artisan identity:prune --dry-run --days=365` with whoever
# owns the retention policy before shortening it.
IDENTITY_RETENTION_ENABLED=false
IDENTITY_RETENTION_DAYS=1825
IDENTITY_RETENTION_CHUNK=500
IDENTITY_RETENTION_DELETE_CDN=true

# ── Analytics ──────────────────────────────────────────────────────────────
# GA4 + Google Ads. Full reasoning in config/analytics.php.

# 🚨 Master switch. OFF outside production by default, and the default is what
# you want: a developer clicking through a checkout twenty times is not twenty
# checkouts, and GA4 CANNOT DELETE an event it has recorded. When false the
# Google tag is not loaded at all and no server-side event is sent.
# Set true only to debug the pipeline, then set it straight back.
ANALYTICS_ENABLED=false

# Server-to-server events (begin_checkout, stripe_connect_started). Those two
# milestones redirect away to Stripe, so the browser cannot report them — and
# the visitor who abandons never comes back, which is the number being measured.
# Create at: GA4 Admin -> Data streams -> your stream -> Measurement Protocol API secrets.
# Unset = server-side events disabled, one log line, never an exception.
GA4_API_SECRET=

# Google's validation endpoint instead of the live one. It REPORTS problems but
# RECORDS NOTHING — the live endpoint answers 204 to a malformed payload exactly
# as it does to a good one. Never true in production.
GA4_MP_DEBUG=false

# Google Ads conversion labels, from Ads -> Goals -> Conversions -> the action ->
# See event snippet (the part of `send_to` after the slash).
# An unset label sends NOTHING for that event, deliberately: a wrong label files
# the conversion against the wrong action, which is worse than none.
# ONE EVENT, ONE ROUTE: `purchase` currently reaches Ads via the GA4-imported
# conversion action, so its label is deliberately empty — filling it in would
# count every sale twice.
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_PURCHASE_LABEL=

# Leaderboard rank-movement notifications (upward moves only). Ships OFF —
# the first real send must be a deliberate act, not a side effect of a deploy.
# Needs queue:work and schedule:work.
LEADERBOARD_MOVEMENT_NOTIFICATIONS=false
LEADERBOARD_MOVEMENT_MIN_PLACES=3
LEADERBOARD_MOVEMENT_PERIOD=weekly
LEADERBOARD_MOVEMENT_MAX_PER_RUN=500

# X (Twitter) Ads. Same two-route split as Google, for the same reason.
# Pixel reports sign_up + purchase; the Conversions API reports begin_checkout
# and stripe_connect_started, which redirect away to Stripe.
# ONE EVENT, ONE ROUTE: X deduplicates the pixel against the API only when both
# carry the same conversion_id, so the two sets are kept disjoint instead.
X_PIXEL_ID=

# 🚨 CREDENTIAL. Anyone holding it can inject conversions into the ad account
# and corrupt its bidding. Never commit it; rotate it if it has ever been sent
# in plaintext.
X_ADS_API_TOKEN=
X_ADS_API_VERSION=12

# X's own event ids, from X Ads -> Events Manager -> the conversion event
# (they look like `tw-ozu4h-xxxxx`). An event with no id here is never reported.
X_EVENT_SIGN_UP=
X_EVENT_PURCHASE=
X_EVENT_BEGIN_CHECKOUT=
X_EVENT_CONNECT_STARTED=
